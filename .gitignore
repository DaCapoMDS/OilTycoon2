# The disc image and anything extracted from it
Big-Oil_Win_EN_Disc-Image/
*.bin
*.cue
*.iso

# The installed game and the decrypted data tree
game/
decrypted/
_staging/

# Mod backups hold copies of ORIGINAL game files - never publish these.
# The mods themselves are tracked; only the backups are not.
mods/.backups/

# Config and logs the game writes next to itself
docs/ot2.cfg.shipped-encrypted
docs/ot2.cfg.runtime-sample
log.txt
*.log
serialreg.txt
maga.mg
*.mg

# Build output
*.exe
*.pdb
*.obj
tools/bin/
